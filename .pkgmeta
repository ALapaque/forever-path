# Empaquetage par BigWigsMods/packager (CurseForge, Wago, GitHub Releases)
package-as: ForeverPath

enable-nolib-creation: no

# deuxième addon livré dans le même zip : les données de terrain (chargées à la demande)
move-folders:
  ForeverPath/ForeverPath_Terrain: ForeverPath_Terrain

ignore:
  - tests
  - tools
  - .github
  - .luacheckrc
  - .gitignore
  - CONTRIBUTING.md
  - INTEGRATIONS.md
  - TERRAIN.md
  - LISTING.md
  - Routes
  - site
  - media-cf
  - Collected

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
